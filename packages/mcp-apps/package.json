   },
   "devDependencies": {
      "@eslint/js": "^8.57.0",
      "@types/bun": "^1.2.21",
      "@typescript-eslint/eslint-plugin": "^8.16.0",
      "@typescript-eslint/parser": "^8.16.0",
      "eslint": "^8.50.0",
      "typescript": "^5.3.3",
      "vite": "^6.3.2"
   }
}

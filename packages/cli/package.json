{
  "name": "@malloy-publisher/cli",
  "version": "0.18.6",
  "description": "Command-line interface for Malloy Publisher: manage environments, packages, connections and materializations.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "malloy-pub": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/malloydata/publisher.git",
    "directory": "packages/cli"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "generate-api-types": "bunx openapi-generator-cli generate -i ../../api-doc.yaml -g typescript-axios -o src/api/generated --additional-properties=supportsES6=true,withSeparateModelsAndApi=true,apiPackage=api,modelPackage=models,stringEnums=true",
    "prebuild": "bun run generate-api-types",
    "build": "bun build src/index.ts --outdir dist --target node --format esm && chmod +x dist/index.js",
    "prepublishOnly": "node -e \"require('fs').accessSync('dist/index.js')\" || (echo 'dist/index.js is missing: run bun run build before npm publish' >&2; exit 1)",
    "dev": "bun run src/index.ts --",
    "lint": "bunx eslint ./src --fix",
    "format": "bunx prettier --write --parser typescript 'src/**/*.{ts,tsx}'",
    "typecheck": "bun run tsc --noEmit",
    "test": "bun test ./src/tests",
    "test:integration": "bun test --timeout 200000 ./tests/integration --max-workers=1"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "cli-table3": "^0.6.5",
    "commander": "^12.1.0",
    "fs-extra": "^11.3.3"
  },
  "devDependencies": {
    "@openapitools/openapi-generator-cli": "^2.40.1",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^24.10.0",
    "@typescript-eslint/eslint-plugin": "^8.16.0",
    "@typescript-eslint/parser": "^8.16.0",
    "eslint": "^8.50.0",
    "prettier": "^3.0.0",
    "typescript": "^5.3.3"
  }
}

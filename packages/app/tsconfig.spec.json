// Typechecks the specs tsconfig.json excludes from the build, as the SDK's
// tsconfig.spec.json does; the root `typecheck:app` runs it second. Keep the
// patterns in step with the exclude list next door.
{
   "extends": "./tsconfig.json",
   "compilerOptions": {
      "noEmit": true,
      "declaration": false
   },
   "include": [
      "src/**/*.spec.*",
      "src/**/*.test.*",
      "src/**/*_spec.*",
      "src/**/*_test.*",
      "test/**/*"
   ],
   "exclude": []
}

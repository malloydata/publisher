{
   "comment": "One protocol, two hosts: read by dataAppBridge.spec.ts (SDK) and publisher.spec.ts (the vanilla Publisher.embed). \"$NONCE\" is the embed's nonce and \"$ID\" the id of the request being answered; every page message here echoes the nonce unless the case says otherwise, and the host never sends one.",
   "appOrigin": "https://app.example.com",
   "events": [
      {
         "name": "a valid event from the frame at the app origin",
         "origin": "https://app.example.com",
         "source": "iframe",
         "message": {
            "protocol": "publisher",
            "v": 1,
            "type": "probe.event",
            "nonce": "$NONCE",
            "payload": { "n": 1 }
         },
         "accept": true,
         "acceptIsolated": false
      },
      {
         "name": "a valid event from a sandboxed frame, whose origin is null",
         "origin": "null",
         "source": "iframe",
         "message": {
            "protocol": "publisher",
            "v": 1,
            "type": "probe.event",
            "nonce": "$NONCE"
         },
         "accept": false,
         "acceptIsolated": true
      },
      {
         "name": "a numeric id is a request and is accepted",
         "origin": "https://app.example.com",
         "source": "iframe",
         "message": {
            "protocol": "publisher",
            "v": 1,
            "type": "probe.event",
            "id": 7,
            "nonce": "$NONCE"
         },
         "accept": true,
         "acceptIsolated": false
      },
      {
         "name": "another origin",
         "origin": "https://evil.example.com",
         "source": "iframe",
         "message": {
            "protocol": "publisher",
            "v": 1,
            "type": "probe.event",
            "nonce": "$NONCE"
         },
         "accept": false,
         "acceptIsolated": false
      },
      {
         "name": "a host name that merely starts with the app origin",
         "origin": "https://app.example.com.evil.example.com",
         "source": "iframe",
         "message": {
            "protocol": "publisher",
            "v": 1,
            "type": "probe.event",
            "nonce": "$NONCE"
         },
         "accept": false,
         "acceptIsolated": false
      },
      {
         "name": "a window other than the frame",
         "origin": "https://app.example.com",
         "source": "other",
         "message": {
            "protocol": "publisher",
            "v": 1,
            "type": "probe.event",
            "nonce": "$NONCE"
         },
         "accept": false,
         "acceptIsolated": false
      },
      {
         "name": "no nonce",
         "origin": "https://app.example.com",
         "source": "iframe",
         "message": { "protocol": "publisher", "v": 1, "type": "probe.event" },
         "accept": false,
         "acceptIsolated": false
      },
      {
         "name": "a wrong nonce",
         "origin": "https://app.example.com",
         "source": "iframe",
         "message": {
            "protocol": "publisher",
            "v": 1,
            "type": "probe.event",
            "nonce": "wrong"
         },
         "accept": false,
         "acceptIsolated": false
      },
      {
         "name": "another protocol",
         "origin": "https://app.example.com",
         "source": "iframe",
         "message": {
            "protocol": "other",
            "v": 1,
            "type": "probe.event",
            "nonce": "$NONCE"
         },
         "accept": false,
         "acceptIsolated": false
      },
      {
         "name": "another version",
         "origin": "https://app.example.com",
         "source": "iframe",
         "message": {
            "protocol": "publisher",
            "v": 2,
            "type": "probe.event",
            "nonce": "$NONCE"
         },
         "accept": false,
         "acceptIsolated": false
      },
      {
         "name": "no type",
         "origin": "https://app.example.com",
         "source": "iframe",
         "message": { "protocol": "publisher", "v": 1, "nonce": "$NONCE" },
         "accept": false,
         "acceptIsolated": false
      },
      {
         "name": "an empty type",
         "origin": "https://app.example.com",
         "source": "iframe",
         "message": {
            "protocol": "publisher",
            "v": 1,
            "type": "",
            "nonce": "$NONCE"
         },
         "accept": false,
         "acceptIsolated": false
      },
      {
         "name": "an id that is neither a string nor a number",
         "origin": "https://app.example.com",
         "source": "iframe",
         "message": {
            "protocol": "publisher",
            "v": 1,
            "type": "probe.event",
            "id": {},
            "nonce": "$NONCE"
         },
         "accept": false,
         "acceptIsolated": false
      },
      {
         "name": "a bare string",
         "origin": "https://app.example.com",
         "source": "iframe",
         "message": "probe.event",
         "accept": false,
         "acceptIsolated": false
      },
      {
         "name": "null",
         "origin": "https://app.example.com",
         "source": "iframe",
         "message": null,
         "accept": false,
         "acceptIsolated": false
      }
   ],
   "handshake": [
      {
         "name": "the reply to hello is the ready signal",
         "message": {
            "protocol": "publisher",
            "v": 1,
            "type": "hello",
            "id": "hello-1",
            "reply": true,
            "nonce": "$NONCE",
            "payload": { "handles": ["givens.set"], "runtime": "1" }
         },
         "probePosted": true,
         "helloPosted": false
      },
      {
         "name": "a reply to hello without the nonce proves nothing",
         "message": {
            "protocol": "publisher",
            "v": 1,
            "type": "hello",
            "id": "hello-1",
            "reply": true,
            "payload": { "handles": [], "runtime": "1" }
         },
         "probePosted": false,
         "helloPosted": false
      },
      {
         "name": "a reply to hello with a wrong nonce proves nothing",
         "message": {
            "protocol": "publisher",
            "v": 1,
            "type": "hello",
            "id": "hello-1",
            "reply": true,
            "nonce": "wrong",
            "payload": { "handles": [], "runtime": "1" }
         },
         "probePosted": false,
         "helloPosted": false
      },
      {
         "name": "an unsolicited ready is answered with a hello, not treated as ready",
         "message": {
            "protocol": "publisher",
            "v": 1,
            "type": "ready",
            "nonce": "$NONCE",
            "payload": { "handles": [], "runtime": "1" }
         },
         "probePosted": false,
         "helloPosted": true
      },
      {
         "name": "an unsolicited ready without the nonce is ignored",
         "message": {
            "protocol": "publisher",
            "v": 1,
            "type": "ready",
            "payload": { "handles": [], "runtime": "1" }
         },
         "probePosted": false,
         "helloPosted": false
      }
   ],
   "replies": [
      {
         "name": "a payload reply resolves the request",
         "message": {
            "protocol": "publisher",
            "v": 1,
            "type": "probe.request",
            "id": "$ID",
            "reply": true,
            "nonce": "$NONCE",
            "payload": { "ok": true }
         },
         "outcome": { "resolves": { "ok": true } }
      },
      {
         "name": "a null payload resolves with null",
         "message": {
            "protocol": "publisher",
            "v": 1,
            "type": "probe.request",
            "id": "$ID",
            "reply": true,
            "nonce": "$NONCE",
            "payload": null
         },
         "outcome": { "resolves": null }
      },
      {
         "name": "an unhandled error rejects with its code",
         "message": {
            "protocol": "publisher",
            "v": 1,
            "type": "probe.request",
            "id": "$ID",
            "reply": true,
            "nonce": "$NONCE",
            "error": {
               "code": "unhandled",
               "message": "No handler for 'probe.request'"
            }
         },
         "outcome": { "rejectsWithCode": "unhandled" }
      },
      {
         "name": "a handler error rejects with its code",
         "message": {
            "protocol": "publisher",
            "v": 1,
            "type": "probe.request",
            "id": "$ID",
            "reply": true,
            "nonce": "$NONCE",
            "error": { "code": "handler_error", "message": "boom" }
         },
         "outcome": { "rejectsWithCode": "handler_error" }
      },
      {
         "name": "a reply without the nonce is ignored and the request times out",
         "message": {
            "protocol": "publisher",
            "v": 1,
            "type": "probe.request",
            "id": "$ID",
            "reply": true,
            "payload": { "ok": true }
         },
         "outcome": { "timesOut": true }
      },
      {
         "name": "a reply for another id is ignored and the request times out",
         "message": {
            "protocol": "publisher",
            "v": 1,
            "type": "probe.request",
            "id": "other",
            "reply": true,
            "nonce": "$NONCE",
            "payload": { "ok": true }
         },
         "outcome": { "timesOut": true }
      }
   ]
}

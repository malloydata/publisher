// Typechecks the test files tsconfig.json excludes from the build.
//
// They must be excluded there, because that config drives the declaration
// build. But excluded also meant unchecked: `bun test` strips types without
// checking them and eslint here is not type-aware, so a type error in a spec
// reached no gate. The root `typecheck:sdk` runs this config as its second
// half. Keep these patterns in step with the exclude list next door -- which
// also excludes `src/**/__test__`, where the helper modules the specs import
// live. Left out here they would be neither built nor checked, which is the
// hole this config exists to close.
{
   "extends": "./tsconfig.json",
   "compilerOptions": {
      "noEmit": true,
      "declaration": false
   },
   "include": [
      "src/**/*.spec.*",
      "src/**/*.test.*",
      "src/**/*_spec.*",
      "src/**/*_test.*",
      "src/**/__test__/**/*",
      "test/**/*"
   ],
   "exclude": []
}

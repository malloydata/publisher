exports[`the gates package's queryability and gates 1`] = `
[
  {
    "modelPath": "gates.malloy",
    "sources": [
      {
        "authorize": [
          {
            "expression": "region = $REGION",
            "givenNames": [
              "REGION",
            ],
            "route": "access_filter",
            "terms": [
              {
                "fieldPath": "region",
                "given": "REGION",
                "op": "=",
              },
            ],
          },
        ],
        "name": "scalar_gate",
        "queryable": true,
      },
      {
        "authorize": [
          {
            "expression": "rep_id in $IDS",
            "givenNames": [
              "IDS",
            ],
            "route": "access_filter",
            "terms": [
              {
                "fieldPath": "rep_id",
                "given": "IDS",
                "op": "in",
              },
            ],
          },
        ],
        "name": "list_gate",
        "queryable": true,
      },
      {
        "authorize": [
          {
            "expression": "reps.rep_name = $NAME",
            "givenNames": [
              "NAME",
            ],
            "route": "access_filter",
            "terms": [
              {
                "fieldPath": "reps.rep_name",
                "given": "NAME",
                "op": "=",
              },
            ],
          },
        ],
        "name": "join_gate",
        "queryable": true,
      },
      {
        "joinOnly": true,
        "name": "join_gate.reps",
        "queryable": true,
      },
      {
        "authorize": [
          {
            "expression": "\`region\` = $REGION",
            "givenNames": [
              "REGION",
            ],
            "route": "access_filter",
            "terms": [
              {
                "fieldPath": "region",
                "given": "REGION",
                "op": "=",
              },
            ],
          },
        ],
        "name": "backtick_gate",
        "queryable": true,
      },
      {
        "authorize": [
          {
            "expression": "reps.\`cost.center\` = $CENTER",
            "givenNames": [
              "CENTER",
            ],
            "route": "access_filter",
          },
        ],
        "name": "dotted_segment_gate",
        "queryable": true,
      },
      {
        "joinOnly": true,
        "name": "dotted_segment_gate.reps",
        "queryable": true,
      },
      {
        "authorize": [
          {
            "expression": "region = $REGION and tenant_id = $TENANT",
            "givenNames": [
              "REGION",
              "TENANT",
            ],
            "route": "access_filter",
            "terms": [
              {
                "fieldPath": "region",
                "given": "REGION",
                "op": "=",
              },
              {
                "fieldPath": "tenant_id",
                "given": "TENANT",
                "op": "=",
              },
            ],
          },
        ],
        "name": "two_terms",
        "queryable": true,
      },
      {
        "authorize": [

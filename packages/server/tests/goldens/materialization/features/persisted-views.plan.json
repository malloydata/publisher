  "loadWarnings": [
    {
      "code": "persist-reads-current-time",
      "message": "#@ persist on view \"recent\" of source \"orders\" stores a relation that reads the current time (`where: created_at > now - 30 days`), so its answers are as of its last build rather than of each query, and it is rebuilt on every run. To answer as of each query instead, move the window into the persisted source's own extend block (a `where:`, dimension or measure there is applied at every read), read a given there, or persist a finer source that keeps the time column and filter it at query time.",
      "model": "m.malloy",
      "severity": "warn",
      "subject": "orders -> recent"
    }

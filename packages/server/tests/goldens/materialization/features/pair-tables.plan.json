            "joinedSourceID": "customers_blocks@<pkg>/m.malloy",
            "keyColumn": "id",
            "pairLevel": 0,
            "queryName": "customers_blocks__mat__pair_key",
            "sql": "WITH __stage0 AS (\n  SELECT \n     base.\"id\" as \"id\",\n     COUNT(1) as \"matches\"\n  FROM (\n    SELECT CAST(id AS BIGINT) AS id, name, segment, home_region,\n           CAST(signup_date AS DATE) AS signup_date\n    FROM read_csv('data/customers.csv', header=true, all_varchar=true)\n  ) as base\n  GROUP BY 1\n)\nSELECT \n   base.\"id\" as \"id\"\nFROM __stage0 as base\nWHERE (base.\"matches\">1) or base.\"id\" IS NULL\nLIMIT 1\n"
          },
          {
            "connectionName": "duckdb",
            "join": "orders",
            "joinedSourceID": "orders_with_lines@<pkg>/m.malloy",
            "keyColumn": "id",
            "pairLevel": 1,
            "queryName": "customers_blocks__mat__pair_key__orders",
            "sql": "WITH __stage0 AS (\n  SELECT \n     base.\"id\" as \"id\",\n     COUNT(1) as \"matches\"\n  FROM (\n    SELECT CAST(id AS BIGINT) AS id, CAST(customer_id AS BIGINT) AS customer_id,\n           region, status,\n           CAST(amount AS DOUBLE) AS amount, CAST(discount AS DOUBLE) AS discount,\n           CAST(order_date AS DATE) AS order_date,\n           CAST(created_at AS TIMESTAMP) AS created_at,\n           CAST(\"order\" AS BIGINT) AS \"order\"\n    FROM read_csv('data/orders.csv', header=true, all_varchar=true)\n  ) as base\n  GROUP BY 1\n)\nSELECT \n   base.\"id\" as \"id\"\nFROM __stage0 as base\nWHERE (base.\"matches\">1) or base.\"id\" IS NULL\nLIMIT 1\n"
          },
          {
            "connectionName": "duckdb",
            "join": "orders.lines",
            "joinedSourceID": "lines@<pkg>/m.malloy",
            "keyColumn": "line_id",
            "pairLevel": 2,
            "queryName": "customers_blocks__mat__pair_leaf_key__orders__lines",
            "recordOnly": true,
            "sql": "WITH __stage0 AS (\n  SELECT \n     base.\"line_id\" as \"line_id\",\n     COUNT(1) as \"matches\"\n  FROM (\n    SELECT CAST(line_id AS BIGINT) AS line_id, CAST(order_id AS BIGINT) AS order_id,\n           sku, CAST(qty AS BIGINT) AS qty\n    FROM read_csv('data/lines.csv', header=true, all_varchar=true)\n  ) as base\n  GROUP BY 1\n)\nSELECT \n   base.\"line_id\" as \"line_id\"\nFROM __stage0 as base\nWHERE (base.\"matches\">1) or base.\"line_id\" IS NULL\nLIMIT 1\n"
          },
          {

            "connectionName": "duckdb",
            "keyColumn": "line_id",
            "sourceID": "lines@<pkg>/m.malloy",
            "sql": "WITH __stage0 AS (\n  SELECT \n     base.\"line_id\" as \"key__check\",\n     COUNT(1) as \"key_rows__check\"\n  FROM (\n    SELECT CAST(line_id AS BIGINT) AS line_id, CAST(order_id AS BIGINT) AS order_id,\n           sku, CAST(qty AS BIGINT) AS qty\n    FROM read_csv('data/lines.csv', header=true, all_varchar=true)\n  ) as base\n  GROUP BY 1\n)\nSELECT \n   base.\"key__check\" as \"key__check\"\nFROM __stage0 as base\nWHERE (base.\"key_rows__check\">1) or base.\"key__check\" IS NULL\nLIMIT 1\n"
          }

##! experimental.givens

// Control tags live on the declaration: a report surfaces the givens it
// imports, and reads their presentation off the declaration.

# label="Brand" control=select suggest { source=orders dimension=brand }
given: BRAND :: filter<string> is f'Nike'

# label="Minimum amount" range_min=0 range_max=500
given: MIN_AMOUNT :: filter<number> is f''

// The only date given: it pins the spelling the shared codec has to send for
// a `date`, which is a bare YYYY-MM-DD; a full ISO timestamp is rejected.
# label="Ordered since"
given: SINCE :: date is @2024-01-01

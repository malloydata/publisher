// A tagged dashboard whose derived name is "v1.2". The dot puts it outside
// letters, digits, "-" and "_", and it IS served: the route matches and the
// published URL carries the path encoded.
// Deliberately NOT a dotfile: the loader ignores those outright, so a
// leading-dot filename never becomes a model and cannot exercise this path.
import { orders } from '../orders.malloy'

## artifact { layout=grid title="Versioned" tiles=["versioned"] }
query: versioned is orders -> {
   group_by: brand_name
   aggregate: total_amount
}

##! experimental.givens
## artifact { layout=linear title="Orders from a start" givens { SINCE=@2024-03-01 } tiles=["orders_tiles -> in_window"] }

// `givens { … }` is where the controls begin: a value the reader arrives at,
// rather than the declaration's default. A URL parameter beats it, so a link
// still shows what the sender was looking at.
import { orders } from "orders.malloy"
import { SINCE } from "givens.malloy"

source: orders_tiles is orders extend {
   # label="Orders in the window"
   view: in_window is since_totals
}

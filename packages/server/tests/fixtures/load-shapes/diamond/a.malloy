import "b.malloy"
import "base.malloy"

// a and b each define `scaled` over the same `items`: v * 3 here, v * 2 in b.
// If b's `scaled` reached `items` itself, `dimension: scaled` below would
// redefine it and this model would not compile. So a compile error is how that
// shows; the totals pin that a_scaled and b_scaled each use their own.
source: a_items is items extend {
  dimension: scaled is v * 3
  measure: scaled_total is scaled.sum()
  join_one: b is b_items on id = b.id
}

#(doc) Expect row_count 6, v_total 210, a_scaled 630, b_scaled 420.
query: check_ab is a_items -> {
  aggregate:
    row_count
    v_total
    a_scaled is scaled_total
    b_scaled is b.scaled_total
}

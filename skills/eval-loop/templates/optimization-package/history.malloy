// Model 1 of the optimization package: production, per day and per model
// version. Read from the CSVs eval-loop's ingest_logs.py and judge_sample.py
// append to data/, or from the managed tables a hosted run loads them into.
// It knows nothing about eval sets; the optimization model reads it, never
// the other way round. Every column is typed here because a table with no
// rows yet is a header-only file.

#(doc) One published version of the served package, and when it went live. The version that served each turn and query, and the record of every change.
source: versions is duckdb.sql("""
  select *, lead(published_at) over (partition by package order by published_at) as replaced_at
  from read_csv('data/model_versions.csv', header = true, columns = {
    'package': 'VARCHAR', 'version': 'VARCHAR', 'commit': 'VARCHAR', 'published_at': 'TIMESTAMP'})
""") extend {
  primary_key: version
  #(doc) Every version, newest first, with the window it served.
  view: timeline is {
    group_by: version, `commit`, published_at, replaced_at
    order_by: published_at desc
  }
}

#(doc) One production question and its answer: a turn, not a session. User traffic only; the loop's own runs are dropped at ingest.
source: turns is duckdb.sql("""
  select * from read_csv('data/prod_turns.csv', header = true, columns = {
    'turn_id': 'VARCHAR', 'session_id': 'VARCHAR', 'at': 'TIMESTAMP', 'environment': 'VARCHAR',
    'package': 'VARCHAR', 'model_version': 'VARCHAR', 'client': 'VARCHAR', 'question': 'VARCHAR',
    'n_get_context': 'INTEGER', 'n_execute': 'INTEGER', 'n_errors': 'INTEGER',
    'tokens': 'BIGINT', 'cost_usd': 'DOUBLE'})
""") extend {
  primary_key: turn_id
  dimension: on_day is `at`.day
  measure:
    #(doc) Production questions asked.
    turn_count is count()
    #(doc) What answering them cost, where the log records it.
    answer_cost_usd is cost_usd.sum()
    #(doc) Turns where a query failed at least once: the agent stumbled.
    turns_with_errors is count() { where: n_errors > 0 }
  #(doc) Traffic per day and version.
  view: by_day is {
    group_by: on_day, model_version
    aggregate: turn_count, turns_with_errors, answer_cost_usd
    order_by: on_day desc
  }
}

#(doc) A judged production turn: right, wrong, or undecided, and for a wrong one the diagnosed reason and owner. Rows are only appended; a new judge or rubric starts a new metric_version, and every quality number is read within one.
source: judgments is duckdb.sql("""
  select * from read_csv('data/prod_judgments.csv', header = true, columns = {
    'turn_id': 'VARCHAR', 'judged_at': 'TIMESTAMP', 'run_id': 'VARCHAR',
    'judge_version': 'VARCHAR', 'metric_version': 'VARCHAR', 'sampled_because': 'VARCHAR',
    'verdict': 'VARCHAR', 'right': 'BOOLEAN', 'failure_code': 'VARCHAR', 'component': 'VARCHAR',
    'owner': 'VARCHAR', 'note': 'VARCHAR'})
""") extend {
  join_one: turn is turns on turn_id = turn.turn_id
  dimension:
    on_day is turn.`at`.day
    model_version is turn.model_version
  measure:
    #(doc) Turns judged, decided or not.
    judged is count()
    #(doc) Turns the judge could decide. The quality rate rests on these.
    decided is count() { where: `right` is not null }
    #(doc) Turns answered right.
    right_count is count() { where: `right` = true }
    #(doc) Production quality: right answers over decided turns. Read within one metric_version.
    quality_rate is right_count / nullif(decided, 0)
  #(doc) Quality per day, version and metric version: the production number the loop moves.
  view: by_day is {
    group_by: metric_version, on_day, model_version
    aggregate: judged, decided, right_count, quality_rate
    order_by: on_day desc
  }
  #(doc) Quality per model version: the number a prediction is checked against.
  view: by_version is {
    group_by: metric_version, model_version
    aggregate: judged, decided, right_count, quality_rate
  }
  #(doc) Why production answers were wrong, and who owns the fix.
  view: failures is {
    where: `right` = false
    group_by: metric_version, failure_code, owner
    aggregate: judged
    order_by: judged desc
  }
}

#(doc) The prices that turn time and bytes into money, written from eval.toml [performance] at each ingest. One row.
source: prices is duckdb.sql("""
  select * from read_csv('data/price_card.csv', header = true, columns = {
    'usd_per_compute_hour': 'DOUBLE', 'usd_per_gb_month': 'DOUBLE', 'usd_per_tb_scanned': 'DOUBLE',
    'max_query_ms': 'DOUBLE', 'max_staleness_hours': 'DOUBLE'})
""")

#(doc) One query run in production by an agent, a data app or the API, with its time and what served it, and what that time cost at the warehouse's price.
source: queries is duckdb.sql("""
  select q.*, q.duration_ms / 3600000.0 * p.usd_per_compute_hour as serve_usd,
         q.duration_ms > p.max_query_ms as over_limit
  from read_csv('data/prod_queries.csv', header = true, columns = {
    'execution_id': 'VARCHAR', 'at': 'TIMESTAMP', 'environment': 'VARCHAR', 'package': 'VARCHAR',
    'model_version': 'VARCHAR', 'model_path': 'VARCHAR', 'source': 'VARCHAR',
    'query_text': 'VARCHAR', 'origin': 'VARCHAR', 'turn_id': 'VARCHAR', 'served_by': 'VARCHAR',
    'table_id': 'VARCHAR', 'duration_ms': 'DOUBLE', 'bytes': 'BIGINT', 'status': 'VARCHAR'}) q
  left join read_csv('data/price_card.csv', header = true, columns = {
    'usd_per_compute_hour': 'DOUBLE', 'usd_per_gb_month': 'DOUBLE', 'usd_per_tb_scanned': 'DOUBLE',
    'max_query_ms': 'DOUBLE', 'max_staleness_hours': 'DOUBLE'}) p on true
""") extend {
  primary_key: execution_id
  dimension: on_day is `at`.day
  measure:
    query_count is count()
    #(doc) Queries slower than max_query_ms: the latency limit.
    over_limit_count is count() { where: over_limit }
    #(doc) Share of queries a materialized table answered.
    table_share is count() { where: served_by != 'live' and served_by is not null } / nullif(count(), 0)
    #(doc) Warehouse time spent serving, in seconds.
    serve_seconds is duration_ms.sum() / 1000
    #(doc) What serving cost: query seconds at the warehouse's price.
    serve_usd_total is serve_usd.sum()
  #(doc) Serving cost and the latency limit per day and version.
  view: by_day is {
    group_by: on_day, model_version
    aggregate: query_count, over_limit_count, table_share, serve_seconds, serve_usd_total
    order_by: on_day desc
  }
  #(doc) Where the time goes: sources by warehouse seconds.
  view: by_source is {
    group_by: `source`, served_by
    aggregate: query_count, serve_seconds, serve_usd_total, over_limit_count
    order_by: serve_seconds desc
  }
}

#(doc) Latency percentiles per day, source and what served it. Computed in SQL because Malloy has no percentile measure; read it at this grain only.
source: latency is duckdb.sql("""
  select cast("at" as date) as on_day, model_version, source, served_by, count(*) as query_count,
         quantile_cont(duration_ms, 0.5) as p50_ms, quantile_cont(duration_ms, 0.95) as p95_ms,
         quantile_cont(duration_ms, 0.99) as p99_ms, max(duration_ms) as max_ms
  from read_csv('data/prod_queries.csv', header = true, columns = {
    'execution_id': 'VARCHAR', 'at': 'TIMESTAMP', 'environment': 'VARCHAR', 'package': 'VARCHAR',
    'model_version': 'VARCHAR', 'model_path': 'VARCHAR', 'source': 'VARCHAR',
    'query_text': 'VARCHAR', 'origin': 'VARCHAR', 'turn_id': 'VARCHAR', 'served_by': 'VARCHAR',
    'table_id': 'VARCHAR', 'duration_ms': 'DOUBLE', 'bytes': 'BIGINT', 'status': 'VARCHAR'})
  group by all
""") extend {
  #(doc) The slowest tails first.
  view: worst is {
    group_by: on_day, `source`, served_by, p50_ms, p95_ms, p99_ms, max_ms, query_count
    order_by: p99_ms desc
    limit: 50
  }
}

#(doc) One build of one materialized table, and what the build cost at the warehouse's price.
source: builds is duckdb.sql("""
  select b.*, b.build_ms / 3600000.0 * p.usd_per_compute_hour as build_usd
  from (
    select * from read_csv('data/prod_table_builds.csv', header = true, columns = {
      'build_id': 'VARCHAR', 'package': 'VARCHAR', 'model_version': 'VARCHAR', 'table_id': 'VARCHAR',
      'source': 'VARCHAR', 'kind': 'VARCHAR', 'grain': 'VARCHAR', 'started_at': 'TIMESTAMP',
      'build_ms': 'DOUBLE', 'rows': 'BIGINT', 'bytes': 'BIGINT', 'status': 'VARCHAR'})) b
  left join read_csv('data/price_card.csv', header = true, columns = {
      'usd_per_compute_hour': 'DOUBLE', 'usd_per_gb_month': 'DOUBLE', 'usd_per_tb_scanned': 'DOUBLE',
      'max_query_ms': 'DOUBLE', 'max_staleness_hours': 'DOUBLE'}) p on true
""") extend {
  primary_key: build_id
  dimension: on_day is started_at.day
  measure:
    build_count is count()
    failed_builds is count() { where: status is not null and status != 'ok' }
    build_seconds is build_ms.sum() / 1000
    build_usd_total is build_usd.sum()
  #(doc) Build cost per day and version.
  view: by_day is {
    group_by: on_day, model_version
    aggregate: build_count, failed_builds, build_seconds, build_usd_total
    order_by: on_day desc
  }
}

#(doc) One materialized table as it stands now: how old its data is against the freshness limit, and what storing its latest build costs a day.
source: tables is duckdb.sql("""
  with b as (
    select * from read_csv('data/prod_table_builds.csv', header = true, columns = {
      'build_id': 'VARCHAR', 'package': 'VARCHAR', 'model_version': 'VARCHAR', 'table_id': 'VARCHAR',
      'source': 'VARCHAR', 'kind': 'VARCHAR', 'grain': 'VARCHAR', 'started_at': 'TIMESTAMP',
      'build_ms': 'DOUBLE', 'rows': 'BIGINT', 'bytes': 'BIGINT', 'status': 'VARCHAR'})
    where status is null or status = 'ok')
  select b.table_id, any_value(b.source) as source, any_value(b.kind) as kind,
         max(b.started_at) as last_built,
         date_diff('minute', max(b.started_at), now()::timestamp) / 60.0 as data_age_hours,
         arg_max(b.bytes, b.started_at) / 1e9 * any_value(p.usd_per_gb_month) / 30 as storage_usd_per_day,
         any_value(p.max_staleness_hours) as max_staleness_hours
  from b left join read_csv('data/price_card.csv', header = true, columns = {
      'usd_per_compute_hour': 'DOUBLE', 'usd_per_gb_month': 'DOUBLE', 'usd_per_tb_scanned': 'DOUBLE',
      'max_query_ms': 'DOUBLE', 'max_staleness_hours': 'DOUBLE'}) p on true
  group by b.table_id
""") extend {
  primary_key: table_id
  dimension: stale is data_age_hours > max_staleness_hours
  measure:
    table_count is count()
    stale_count is count() { where: stale }
    storage_usd_day is storage_usd_per_day.sum()
  #(doc) Every table, oldest data first.
  view: freshness is {
    group_by: table_id, `source`, kind, last_built, data_age_hours, stale, storage_usd_per_day
    order_by: data_age_hours desc
  }
}

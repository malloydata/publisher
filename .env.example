# Copy to .env in the directory you start Publisher from. Bun loads .env
# automatically, so no flag or export is needed. .env is gitignored; this
# example file is not, so never put a real key here.
#
# Everything below is optional: with none of it set, get_context ranks by
# keyword and stored values and Publisher works. docs/configuration.md has the
# full flag list.

# --- Semantic retrieval -----------------------------------------------------
# Setting this one variable is what turns embedding closeness on in
# get_context's search. Without it, a question only matches fields that share
# words with it, so "departure delay" never finds a field named dep_delay.
EMBEDDING_API_KEY=sk-your-key-here

# Embedding model. The default is OpenAI's small model.
# EMBEDDING_MODEL=text-embedding-3-small

# Any OpenAI-compatible /embeddings endpoint. Point this at a local Ollama or
# vLLM server to keep model text on-machine, and set EMBEDDING_MODEL to
# something that server actually serves.
# EMBEDDING_API_BASE=https://api.openai.com/v1

# Shrink the vectors. 768 measured indistinguishable from the full 1536 on the
# bundled examples (top hit 0.931 vs 0.930) at half the storage, so it is a
# reasonable default to set deliberately. Omit to use the model's native size.
# EMBEDDING_DIMENSIONS=768

# Cosine floor a table must clear to be returned by search_database_schema
# (get_context has no floor). Must be in [0, 1). The right value belongs to the
# embedding model, not to Publisher.
# EMBEDDING_MIN_SIMILARITY=0.2

# A SECOND opt-in, on top of EMBEDDING_API_KEY: allows search_database_schema
# to send a connection's schema, table and column names to the embedding
# endpoint for ranking. Never row values. Unset, schema search ranks lexically.
# EMBEDDING_INDEX_CONNECTION_SCHEMA=false

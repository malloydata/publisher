// ─────────────────────────────────────────────────────────────────────────
// Access control, built on the same givens mechanism.
//
//   #(authorize)  decides WHETHER a caller may query the source (403 if not).
//   where:        decides WHICH rows they see once allowed (row-level access).
//
// Both read caller-supplied givens (ROLE, TENANT). They are a real boundary
// only behind a trusted tier that sets those givens from verified identity —
// givens are caller-asserted. See docs/authorize.md and docs/row-level-access.md.
// ─────────────────────────────────────────────────────────────────────────
##! experimental.givens

import { orders_base } from "internal.malloy"

// Neither given may carry a default: the gate below references both, and a
// referenced given with a default is refused at load (a caller who supplies
// nothing would otherwise silently resolve to that default). One consequence:
// since `where:` also references both, a caller MUST supply both keys on every
// request — even the one whose value the caller's path doesn't care about
// (send it as "") — or Malloy refuses to resolve the unsupplied given at all
// and the request is denied with a 403, rather than binding to an implicit
// empty default the way the retired string form's example did.
given:
  ROLE :: string
  TENANT :: string

source: orders_secured is orders_base extend {
  // Row-level access: admins see everything; a tenant caller sees only its rows.
  where: $ROLE = 'admin' or tenant = $TENANT

  measure:
    #(doc) Number of orders visible to this caller
    order_count is count()
    #(doc) Total order amount visible to this caller
    # currency=usd
    total_amount is amount.sum()

  view: by_status is {
    group_by: status
    aggregate: order_count, total_amount
  }

  view: by_tenant is {
    group_by: tenant
    aggregate: order_count, total_amount
  }

  // Authorization is a single disjunction: an admin override, plus a tenant
  // allow-list. Send both givens on every request (see the note above) — the
  // one not on the caller's path just fails to match. See docs/authorize.md.
  #(authorize)
  internal dimension: authorized is
    $ROLE = 'admin' or $TENANT = 'acme' or $TENANT = 'globex' or $TENANT = 'initech'
}

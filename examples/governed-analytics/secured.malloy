// ─────────────────────────────────────────────────────────────────────────
// Access control, built on the givens mechanism.
//
//   #(row_authorize)  decides WHICH rows this caller may read. Enforced as a
//                     row filter, so a caller it admits nowhere gets 200 with
//                     zero rows, not a 403 — row-level access on its own here,
//                     with no separate `where:` needed since the gate's own
//                     predicate already scopes the rows.
//
// It reads a caller-supplied given (TENANTS). It is a real boundary only
// behind a trusted tier that sets it from verified identity — givens are
// caller-asserted. See docs/authorize.md and docs/row-level-access.md.
// ─────────────────────────────────────────────────────────────────────────
##! experimental.givens

import { orders_base } from "internal.malloy"

// TENANTS may not carry a default: the gate below references it, and a
// referenced given with a default is refused at load (a caller who supplies
// nothing would otherwise silently resolve to that default). An admin caller
// is not a separate role — it is simply handed every tenant on this list by
// the trusted tier that resolves identity into givens.
given:
  TENANTS :: string[]

// Authorization: the caller may read only the tenants their identity was
// resolved to. See docs/authorize.md.
#(row_authorize) tenant in $TENANTS
source: orders_secured is orders_base extend {
  measure:
    #(doc) Number of orders visible to this caller
    order_count is count()
    #(doc) Total order amount visible to this caller
    # currency=usd
    total_amount is amount.sum()

  view: by_status is {
    group_by: status
    aggregate: order_count, total_amount
  }

  view: by_tenant is {
    group_by: tenant
    aggregate: order_count, total_amount
  }
}

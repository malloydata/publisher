// Shared base source for the governed-analytics package.
//
// `orders_base` is intentionally NOT exported by this package's index.malloy,
// so it is hidden from discovery and a direct `run: orders_base -> ...` is
// denied with a 404. It still compiles and is imported and extended by both
// public models. See docs/discovery-and-access.md.
source: orders_base is duckdb.table('orders.parquet')

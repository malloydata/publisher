// Layer C, part 2: dbt's marts in Malloy, materialized with `#@ persist`.
//
// dbt materializes these as tables. In Malloy the equivalent is one annotation per source:
// `#@ persist name="..."`. There is no separate config block, no materialization strategy,
// and no incremental strategy to choose -- the build plan comes from the annotations.
//
// Persistence only applies to a query source (a `-> { ... }` pipeline, optionally refined by
// a trailing `extend { ... }`). A `#@ persist` on a plain `extend` over a table is silently
// ignored, which is why every source here is a pipeline.
//
// A standalone Publisher does not build on publish. Trigger a build explicitly:
//   malloy-pub materialize --package dbt-jaffle-shop-transforms --wait

##! experimental.persistence

import "staging.malloy"

// ── Intermediate: not a dbt model, but dbt's own `order_items.sql` computes the same
// per-product supply rollup inline as a CTE. It is a source here so `order_items` can join it.

#(doc) Total supply cost per product, summed across every supply that product needs
source: supply_costs is stg_supplies -> {
   group_by: product_id
   aggregate: supply_cost is supply_cost.sum()
} extend {
   primary_key: product_id
}

// ── Marts ──────────────────────────────────────────────────────────────────

#(doc) Items contained in each order. The grain of the table is one row per order item.
#@ persist name="order_items"
source: order_items is stg_order_items extend {
   join_one: stg_orders with order_id
   join_one: stg_products with product_id
   join_one: supply_costs with product_id
} -> {
   select:
      #(doc) The unique key of the order items mart
      order_item_id
      #(doc) The order this item belongs to
      order_id
      #(doc) The product sold on this line
      product_id

      #(doc) The day the order was placed
      ordered_at is stg_orders.ordered_at

      #(doc) Name of the product sold
      product_name is stg_products.product_name
      #(doc) Price of the product in USD
      product_price is stg_products.product_price
      #(doc) Whether this line is a food item
      is_food_item is stg_products.is_food_item
      #(doc) Whether this line is a drink item
      is_drink_item is stg_products.is_drink_item

      #(doc) Cost of the supplies needed to make this product, in USD
      supply_cost is supply_costs.supply_cost
} extend {
   primary_key: order_item_id
}

#(doc) Order overview data mart, offering key details for each order including if it's a
#(doc) customer's first order and a food vs. drink item breakdown. One row per order.
#@ persist name="orders"
source: orders is stg_orders extend {
   join_many: order_items on order_id = order_items.order_id
} -> {
   group_by:
      order_id, location_id, customer_id
      subtotal_cents, tax_paid_cents, order_total_cents
      subtotal, tax_paid, order_total
      ordered_at
   aggregate:
      #(doc) The sum of supply expenses to fulfill the order
      order_cost is order_items.supply_cost.sum()
      #(doc) The sum of product prices on the order, before tax
      order_items_subtotal is order_items.product_price.sum()
      #(doc) Number of items on the order
      count_order_items is count(order_items.order_item_id)
      #(doc) Number of food items on the order
      count_food_items is count(order_items.order_item_id) { where: order_items.is_food_item }
      #(doc) Number of drink items on the order
      count_drink_items is count(order_items.order_item_id) { where: order_items.is_drink_item }
   // dbt's orders.sql closes with
   //   row_number() over (partition by customer_id order by ordered_at asc)
   // which is a window, not an aggregate. In Malloy it is a `calculate:`, and the whole
   // source is then persisted -- the same trade dbt makes by materializing the mart.
   calculate:
      #(doc) This order's position in the customer's own order history, 1 being their first
      customer_order_number is row_number() {
         partition_by: customer_id
         order_by: ordered_at asc
      }
} extend {
   primary_key: order_id
   dimension:
      #(doc) A boolean indicating if this order included any food items
      is_food_order is count_food_items > 0
      #(doc) A boolean indicating if this order included any drink items
      is_drink_order is count_drink_items > 0
}

#(doc) Customer overview data mart, offering key details for each unique customer.
#(doc) One row per customer.
#@ persist name="customers"
source: customers is stg_customers extend {
   join_many: orders on customer_id = orders.customer_id
} -> {
   group_by:
      customer_id, customer_name
   aggregate:
      #(doc) Total count of orders per customer
      count_lifetime_orders is count(orders.order_id)
      #(doc) The timestamp of the customer's first order
      first_ordered_at is orders.ordered_at.min()
      #(doc) The timestamp of the customer's most recent order
      last_ordered_at is orders.ordered_at.max()
      #(doc) Customer's lifetime spend before tax
      lifetime_spend_pretax is orders.subtotal.sum()
      #(doc) The sum of all tax the customer has paid
      lifetime_tax_paid is orders.tax_paid.sum()
      #(doc) Gross customer lifetime spend inclusive of taxes
      lifetime_spend is orders.order_total.sum()
} extend {
   primary_key: customer_id
   dimension:
      #(doc) Whether the customer has ordered more than once: `returning`, else `new`
      customer_type is pick 'returning' when count_lifetime_orders > 1 else 'new'
}

// These three marts are passthroughs of their staging models in dbt too -- the mart file
// selects the staging model unchanged. They are persisted because dbt materializes them as
// tables, and because they are join targets for the two marts above.

#(doc) Product dimension table. The grain of the table is one row per product.
#@ persist name="products"
source: products is stg_products -> { select: * } extend {
   primary_key: product_id
}

#(doc) Supplies dimension table. The grain of the table is one row per supply and product
#(doc) combination.
#@ persist name="supplies"
source: supplies is stg_supplies -> { select: * } extend {
   primary_key: supply_uuid
}

#(doc) Location dimension table. The grain of the table is one row per location.
#@ persist name="locations"
source: locations is stg_locations -> { select: * } extend {
   primary_key: location_id
}

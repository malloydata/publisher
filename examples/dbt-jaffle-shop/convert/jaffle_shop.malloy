// The semantic layer: dbt's metrics, over marts Malloy built.
//
// Every source, measure, and view below is the same text as the `adopt` package's semantic
// layer. The only difference is what each source extends: `adopt` reads the marts dbt built
// from Parquet, this reads the marts marts.malloy rebuilt and persisted from the raw data.
//
// That is the pair's whole argument. `run: orders -> order_metrics` is the same query, with
// the same numbers, against either package. Where the tables come from is a plumbing
// decision that the people and agents querying the model never see.

##! experimental.persistence

import "marts.malloy"

#(doc) Customer overview data mart, offering key details for each unique customer. One row per customer.
source: customers is customers_mart extend {
  primary_key: customer_id

  measure:
    #(doc) LTV pre-tax / number of orders
    # label="Average Order Value"
    average_order_value is lifetime_spend_pretax / nullif(count_lifetime_orders, 0)

    #(doc) Total count of orders per customer.
    # label="Count Lifetime Orders"
    count_lifetime_orders is count_lifetime_orders_raw.sum()

    #(doc) Count of unique customers
    # label="Customers"
    customers is count(customer_id)

    #(doc) Gross customer lifetime spend inclusive of taxes.
    # label="Lifetime Spend"
    lifetime_spend is lifetime_spend_raw.sum()

    #(doc) Customer's lifetime spend before tax
    # label="LTV Pre-tax"
    lifetime_spend_pretax is lifetime_spend_pretax_raw.sum()

  #(doc) Key customer order metrics grouped by customer.
  view: customer_order_metrics is {
    group_by:
      customer_id
    aggregate:
      count_lifetime_orders
      lifetime_spend_pretax
      average_order_value
  }
}

#(doc) Location dimension table. The grain of the table is one row per location.
source: locations is locations_mart extend {
  primary_key: location_id

  measure:
    #(doc) Average tax rate.
    # label="Average Tax Rate"
    average_tax_rate is tax_rate.avg()
}

#(doc) Order overview data mart, offering key details for each order inlcluding if it's a customer's first order and a food vs. drink item breakdown. One row per order.
source: orders is orders_mart extend {
  primary_key: order_id

  join_one:
    #(doc) The foreign key relating to the customer who placed the order.
    customers with customer_id
    locations with location_id

  measure:
    #(doc) Count of orders that contain drink order items
    # label="Drink Orders"
    drink_orders is count() { where: is_drink_order }

    #(doc) Count of orders that contain food order items
    # label="Food Orders"
    food_orders is count() { where: is_food_order }

    #(doc) Count of orders with order total over 20.
    # label="Large Orders"
    large_orders is count() { where: order_total_raw >= 20 }

    #(doc) New customer's first order count
    # label="New Customers"
    new_customer_orders is count() { where: customer_order_number = 1 }

    #(doc) The cost for each order item. Cost is calculated as a sum of the supply cost for each order item.
    # label="Order Cost"
    order_cost is order_cost_raw.sum()

    #(doc) Sum of total order amount. Includes tax + revenue.
    # label="Order Total"
    order_total is order_total_raw.sum()

    #(doc) Count of orders.
    # label="Orders"
    orders is count()

    #(doc) The total tax paid on each order.
    # label="Tax Paid"
    tax_paid is tax_paid_raw.sum()

  #(doc) Key order metrics grouped by day.
  view: order_metrics is {
    group_by:
      ordered_at_day is ordered_at.day
    aggregate:
      orders
      new_customer_orders
      order_total
      food_orders
      drink_orders
  }
}

#(doc) Product dimension table. The grain of the table is one row per product.
source: products is products_mart extend {
  primary_key: product_id
}

#(doc) Items contained in each order. The grain of the table is one row per order item.
source: order_items is order_items_mart extend {
  primary_key: order_item_id

  join_one:
    orders with order_id
    products with product_id

  measure:
    #(doc) The revenue from drinks in each order
    # label="Drink Revenue"
    drink_revenue is product_price.sum() { where: is_drink_item }

    #(doc) The % of order revenue from drinks.
    # label="Drink Revenue %"
    drink_revenue_pct is drink_revenue / nullif(revenue, 0)

    #(doc) The revenue from food in each order
    # label="Food Revenue"
    food_revenue is product_price.sum() { where: is_food_item }

    #(doc) The % of order revenue from food.
    # label="Food Revenue %"
    food_revenue_pct is food_revenue / nullif(revenue, 0)

    #(doc) Gross profit from each order.
    # label="Order Gross Profit"
    order_gross_profit is revenue - orders.order_cost

    #(doc) The revenue generated for each order item. Revenue is calculated as a sum of revenue associated with each product in an order.
    # label="Revenue"
    revenue is product_price.sum()

  #(doc) Key revenue metrics grouped by day.
  view: revenue_metrics is {
    group_by:
      ordered_at_day is ordered_at.day
    aggregate:
      revenue
      food_revenue
      drink_revenue
  }

   // dbt: metric `revenue_growth_mom`, type `derived`, expr
   //   (current_revenue - revenue_prev_month)*100/revenue_prev_month
   // with its second input offset by `offset_window: {count: 1, granularity: month}`.
   //
   // The offset is what makes this a window rather than an aggregate: the row for March
   // has to see February's value. dbt's OSI export drops the offset and emits
   // `(SUM(x) - SUM(x))*100/SUM(x)`, which is always zero -- see ../COVERAGE.md.
   #(doc) Revenue by month with month-over-month growth as a percentage
   # line_chart
   view: revenue_growth_mom is {
      group_by: revenue_month is ordered_at.month
      aggregate: revenue
      calculate: revenue_prev_month is lag(revenue)
      calculate:
         # percent
         revenue_growth_mom is (revenue - lag(revenue)) / nullif(lag(revenue), 0)
      order_by: revenue_month
   }

   // dbt: metric `cumulative_revenue`, type `cumulative`, over metric `revenue` with an
   // all-time window. dbt itself warns this one cannot be represented in OSI.
   #(doc) Running total of revenue over time, all-time cumulative
   # line_chart
   view: cumulative_revenue is {
      group_by: revenue_month is ordered_at.month
      aggregate: revenue
      calculate:
         # currency
         cumulative_revenue is sum_cumulative(revenue)
      order_by: revenue_month
   }

   #(doc) Revenue trend, growth, and running total in one view
   # dashboard
   view: revenue_over_time is {
      nest:
         # big_value
         totals is {
            aggregate:
               # label="Revenue"
               # currency
               revenue
               # label="Food revenue"
               # currency
               food_revenue
               # label="Drink revenue"
               # currency
               drink_revenue
         }
      nest: revenue_growth_mom
      nest: cumulative_revenue
   }
}

#(doc) Supplies dimension table. The grain of the table is one row per supply and product combination.
source: supplies is supplies_mart extend {
  primary_key: supply_uuid
}

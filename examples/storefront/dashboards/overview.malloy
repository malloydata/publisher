// A dashboard: `## artifact { tiles=[…] }` at model level, one tile per named
// view, laid out by Publisher into the grid `# dashboard { columns=N }` names.
//
// The tag has to be model-level because a composite has no query of its own to
// hang a `#` tag on, and it is model-level for a second reason worth knowing:
// tiles run as separate queries, which is the only way a dashboard can span
// unrelated sources. A nest's pipeline starts from its own query's source, so no
// single Malloy result does.
//
// The givens are imported so the control row is bindable. Malloy's given
// namespace is per-file: a tile's `where: … ~ $CATEGORY` lives over in
// data_app.malloy, and without these imports this file surfaces no givens and
// binding one at run time fails.
//
// Compare `order_items -> business_overview` in storefront.malloy, which is the
// same figures as one query with nests. That form is Malloy's own rendering
// feature and still works; this is the form to author a dashboard in.
##! experimental.givens
## artifact { title="Storefront overview" tiles=["overview -> kpis", "overview -> revenue_trend", "overview -> revenue_by_state", "overview -> revenue_by_category", "overview -> best_sellers"] } dashboard { columns=12 }
import "../data_app.malloy"
import "../givens.malloy"
// The givens arrive as a WHOLE-FILE import, not as a named list, and that is
// the convention rather than a shortcut. A control renders for a given the
// tiles actually reference, not for every one in scope, so importing the file
// costs nothing and a named list only makes the author enumerate — and forget.
// It is also what Malloyyo documents as best practice for the same format, so
// a repo written for either side reads the same.
//
// They have to arrive somehow: a bare import is not TRANSITIVE, so they do not
// ride in with `scoped_orders` from data_app.malloy. Without this line the file
// surfaces no givens at all and binding one at run time fails.
//
// The source names below are listed rather than whole-file imported, and that
// asymmetry is deliberate: this file needs four specific names out of
// storefront.malloy, and the controls' `suggest { source= }` and
// `suggest { query= }` point at names this file cannot otherwise see, so the
// load lint says so rather than serving a picker with no options.
//
// `order_items` is here for the same reason and is the half the lint does NOT
// catch: `brand_suggest` resolves as a name, so the lint passes, but running it
// needs the source it reads, and without this the Brand picker answers 400
// "Undefined source 'order_items'" and offers no options.
import {
   order_items,
   products,
   regions,
   brand_suggest
} from "../storefront.malloy"

// Layout lives on the view, which is what lets one view lay out the same way
// whether it is named as a tile here or nested under a `# dashboard` query. The
// reusable views keep their own chart tags in storefront.malloy; this extension
// adds only how wide each one sits and what it is called.
//
// `# colspan` and `# break` are @malloydata/render's own per-child dashboard
// tags, read the same way and clamped to `columns` the same way, so the two
// forms cannot drift.
#(doc) The overview dashboard's tiles, over the control row's filtered orders
source: overview is scoped_orders extend {
  // A full-width KPI strip. `# big_value` renders each aggregate as a figure
  // rather than a table row.
  # colspan=12
  # label="Key figures"
  # big_value
  view: kpis is {
    aggregate:
      # label="Revenue"
      # currency
      total_sales
      # label="Gross margin"
      # currency
      total_margin
      # label="Orders"
      order_count
      # label="Customers"
      customer_count
      # label="Avg order value"
      # currency
      avg_order_value
  }

  // `# break` starts a fresh row, so the trend leads the second row however the
  // strip above it wraps.
  //
  // Six and six rather than eight and four, and the map is why. A root
  // `# shape_map` is drawn at a size of its own — @malloydata/render builds its
  // spec from a hardcoded 500x350, 588px wide once its legend is on, and no tag
  // reads those numbers — so it does not shrink into a narrower tile, it is
  // clipped by one. At four of twelve the tile was ~401px and the east coast
  // and the whole legend were cut off; six is ~631px here and fits.
  //
  // Sized to the constant, not eyeballed: the map fits whenever its tile is at
  // least 588px, which at six of twelve means a grid of about 1220px. Narrower
  // than that and it clips again, and no colspan available here avoids it —
  // that is the renderer's fixed size, not this dashboard's layout.
  # colspan=6
  # break
  # label="Revenue by month"
  view: revenue_trend is sales_by_month

  # colspan=6
  # label="Revenue by state"
  view: revenue_by_state is sales_by_state

  # colspan=6
  # break
  # label="Revenue by category"
  view: revenue_by_category is by_category

  # colspan=6
  # label="Top products"
  view: best_sellers is top_products
}

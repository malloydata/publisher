{
  "frozenConfig": false,
  "servingApiEnabled": true,
  "adminApiEnabled": true,
  "port": null,
  "host": null,
  "rateLimit": 0,
  "frameAncestors": "'self'",
  "callerHeader": "x-publisher-caller",
  "packageVersioning": "on",
  "versionPromotion": "on-publish",
  "packageInlineFields": "on",
  "modelPage": "explorer",
  "theme": null,
  "environments": null,
  "mcp": {
    "port": 4040,
    "host": null,
    "corsOrigins": [],
    "configFileEnabled": true,
    "includeHiddenFilesAndSources": false,
    "appOrigin": null,
    "trace": null
  },
  "admin": {
    "port": null,
    "host": "127.0.0.1",
    "catalogDatabase": null,
    "storage": {
      "provider": null,
      "keyId": null,
      "secret": null,
      "region": null,
      "endpoint": null
    }
  },
  "query": {
    "maxRows": 100000,
    "maxResponseBytes": 50000000,
    "defaultRowLimit": 1000,
    "timeoutMs": 300000,
    "maxConcurrent": 32,
    "metadataEnabled": false
  },
  "postgres": {
    "poolMax": 5
  },
  "memory": {
    "maxBytes": 0,
    "highWaterFraction": 0.8,
    "lowWaterFraction": 0.7,
    "checkIntervalMs": 5000,
    "backpressureEnabled": true
  },
  "packageLoad": {
    "workers": 1,
    "jobTimeoutMs": 120000,
    "schemaCacheBytes": 16777216
  },
  "duckdb": {
    "extensionFetchPolicy": "on-demand",
    "memoryLimit": null,
    "threads": null,
    "tempDirectory": null,
    "partitionedWriteFlushThreshold": "8192"
  },
  "ducklake": {
    "rowGroupSizeBytes": null,
    "targetFileSizeBytes": null
  },
  "persist": {
    "storageMode": "off",
    "addressIncludesDestination": false,
    "collisionEnforcementEnabled": true
  },
  "materialize": {
    "enabled": false,
    "gatedSources": false
  },
  "materialization": {
    "schedulerEnabled": false,
    "schedulerIntervalMs": 60000,
    "schedulerMaxFiresPerTick": 10
  },
  "allow": {
    "proxyConnections": false,
    "duckdbSetupSql": false,
    "unverifiedSshHostKey": false,
    "s3CredentialChain": "any"
  },
  "authorize": {
    "bypassSecret": null
  },
  "logging": {
    "level": "debug",
    "responseBodiesEnabled": true
  },
  "shutdown": {
    "drainDurationSeconds": 0,
    "gracefulCloseTimeoutSeconds": 0
  },
  "workloadLog": {
    "store": "off",
    "retentionDays": 30,
    "maxRows": 1000000
  },
  "retrieval": {
    "llm": {
      "provider": null,
      "model": null,
      "baseUrl": null,
      "projectId": null,
      "location": null,
      "timeoutMs": null,
      "concurrency": null,
      "maxCallsPerSync": null,
      "maxCallsPerRequest": null,
      "apiKey": null
    },
    "embedding": {
      "provider": null,
      "projectId": null,
      "location": null,
      "queryPrefix": null,
      "documentPrefix": null,
      "apiKey": null,
      "model": null,
      "baseUrl": null,
      "dimensions": null,
      "minSimilarity": null,
      "connectionSchemaIndexingEnabled": null
    },
    "egress": {
      "preset": null
    },
    "dimensionValues": {
      "enabled": null
    }
  }
